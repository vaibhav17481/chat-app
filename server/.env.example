# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/chat_app?schema=public"

# Port the HTTP / Socket.IO server listens on
PORT=5000

# Secret used to sign the JWTs and to hash the verification codes
JWT_SECRET=change-me-to-a-long-random-string

# Gmail account used to deliver the verification codes
EMAIL_USER=you@gmail.com
EMAIL_APP_PASSWORD=your-16-character-gmail-app-password

# Optional: use a different SMTP server instead of Gmail (local development
# and automated tests). Leave empty to use the Gmail transport.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

# Optional: database used by the automated test suite
TEST_DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/chat_app_test?schema=public"
